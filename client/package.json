{
  "name": "@presence/client",
  "version": "0.1.0",
  "private": true,
  "description": "Presence consumer client — React Native + Expo custom dev client (TECH-01). Expo Go is prohibited: BLE presence requires native modules.",
  "scripts": {
    "start": "npx expo start --dev-client",
    "prebuild": "npx expo prebuild",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && node --test dist/test/"
  },
  "dependencies": {
    "expo": "~58.0.0",
    "expo-dev-client": "~58.0.0",
    "expo-secure-store": "~58.0.0",
    "expo-status-bar": "~58.0.0",
    "h3-js": "^4.2.1",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "^19.1.1",
    "typescript": "5.6.3"
  }
}
